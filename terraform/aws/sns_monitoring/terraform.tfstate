            "output_size": 372,
            "source": [
              {
                "content": "import urllib.request\nimport os\n\ndef lambda_handler(event, context):\n    url = os.environ['base_url']\n    try:\n        response = urllib.request.urlopen(url)\n        if response.getcode() != 200:\n            raise Exception(\"The {url} url is not working properly!\".format(url=url))\n    except Exception as e:\n        raise Exception(\"The {url} url is not working properly!\".format(url=url))\n",
                "filename": "monikanova_mon_lambda.py"
              }
            ],
            "source_content": null,
            "source_content_filename": null,
            "source_dir": null,
            "source_file": null,
            "type": "zip"
          },
          "sensitive_attributes": [],
          "identity_schema_version": 0
        }
      ]
